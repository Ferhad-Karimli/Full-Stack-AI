{
  "name": "evim-backend",
  "version": "1.0.0",
  "description": "Evim — rental portal REST API (Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/seed.js --reset",
    "start:prod": "node src/db/migrate.js && node src/db/seed.js --if-empty && node src/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  }
}
