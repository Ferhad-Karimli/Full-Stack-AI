# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Local:  postgresql://postgres:postgres@localhost:5432/evim
# Neon:   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/evim?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evim
# Set to true for hosted databases (Neon, Supabase, Render external URL)
DATABASE_SSL=false

# Allowed frontend origins, comma-separated
CORS_ORIGIN=http://localhost:3000
# Allow any *.vercel.app preview URL
CORS_ALLOW_VERCEL_PREVIEWS=false
